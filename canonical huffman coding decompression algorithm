void decompressFile()
{
    ifstream input("compressed.bin", ios::binary);
    if (!input)
    {
        cout << "\ncompressed.bin not found!\n";
        return;
    }

    char mode;
    if (!input.get(mode) || (mode != 0 && mode != 1))
    {
        cout << "\nInvalid compressed file!\n";
        return;
    }

    if (mode == 0)
    {
        ofstream raw("decompressed.txt", ios::binary);
        char c;
        while (input.get(c))
            raw.put(c);
        cout << "\nDecompression completed: decompressed.txt\n";
        return;
    }

    unsigned int total;
    input.read((char*)&total, 4);

    char u;
    input.get(u);
    int unique = (unsigned char)u + 1;

    int len[256] = {0};
    for (int i = 0; i < unique; i++)
    {
        char c, l;
        input.get(c);
        input.get(l);
        len[(unsigned char)c] = (unsigned char)l;
    }

    // Step 2: rebuild the SAME canonical codes from the lengths
    unsigned long long code[256], first[MAXLEN + 1];
    int cnt[MAXLEN + 1], offset[MAXLEN + 1], sorted[256];
    buildCanonical(len, code, first, cnt, offset, sorted);

    ofstream output("decompressed.txt", ios::binary);

    // Step 3: read bits; after each bit check if the code read so far is a real code
    unsigned long long cur = 0;
    int curLen = 0;
    unsigned int done = 0;
    char byte;
    int error = 0;

    while (input.get(byte) && done < total && !error)
    {
        for (int i = 7; i >= 0 && done < total; i--)
        {
            int bit = ((unsigned char)byte >> i) & 1;
            cur = (cur << 1) | bit;
            curLen++;

            if (curLen > MAXLEN)
            {
                error = 1;
                break;
            }

            if (cnt[curLen] > 0 && cur >= first[curLen] && cur - first[curLen] < (unsigned long long)cnt[curLen])
            {
                int ch = sorted[offset[curLen] + (int)(cur - first[curLen])];
                output.put((char)ch);
                done++;
                cur = 0;
                curLen = 0;
            }
        }
    }

    input.close();
    output.close();

    if (error)
        cout << "\nCompressed file is damaged!\n";
    else
        cout << "\nDecompression completed: decompressed.txt\n";
}

